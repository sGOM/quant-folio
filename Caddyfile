# QuantFolio 단일 출처 리버스 프록시.
# 프론트(Next.js)와 백엔드(FastAPI)를 한 포트로 합쳐, 브라우저가 항상 같은
# 출처로 접속하게 한다. 이렇게 하면:
#  - 폰이 어떤 주소(WireGuard IP)로 들어와도 프론트가 상대경로로 API·WS 를
#    호출하므로 주소가 바뀌어도 프론트 재빌드가 필요 없다.
#  - 프론트/백엔드가 같은 출처가 되어 CORS·교차출처 쿠키 문제가 사라진다
#    (모바일 Safari 의 엄격한 SameSite/Secure 정책에서도 인증이 안정적).
#
# 두 가지로 동시에 서빙한다:
#  - :80  평문 HTTP — localhost 확인용, WireGuard 터널 내부(이미 암호화)용.
#  - :443 HTTPS    — Caddy 내부 CA 가 자체 서명 인증서를 자동 발급한다.
#                    WireGuard IP(WG_HOST)를 대상으로 발급하며, 폰에 루트 CA 를
#                    한 번 설치하면 브라우저 자물쇠가 정상 표시된다.
#                    (공인 도메인이 있다면 아래 tls internal 대신 도메인+ACME 로
#                     공인 인증서를 받을 수 있다 — README 6단계 참고.)
#
# WG_HOST 는 환경변수로 주입한다(.env: WG_HOST=10.8.0.1). compose 가 전달한다.

{
	admin off
	auto_https disable_redirects
}

# HTTP/HTTPS 양쪽에서 재사용하는 공통 라우팅
(routes) {
	# 백엔드(FastAPI)로 보내는 경로. 나머지는 모두 프론트로 간다.
	@backend path /api/* /ws /ws/* /health /docs /openapi.json /redoc
	handle @backend {
		# reverse_proxy 는 WebSocket Upgrade 를 자동 처리한다(/ws 실시간 피드).
		reverse_proxy web:8000 {
			# 클라이언트가 직접 실어 보낸 X-Forwarded-For 를 신뢰하지 않도록,
			# Caddy 가 실제로 관측한 접속 IP({remote_host})로 항상 덮어쓴다.
			# (기본 reverse_proxy 는 기존 값 뒤에 append 만 하므로 이 설정 없이는
			#  스푸핑된 첫 항목을 백엔드가 그대로 신뢰하게 되어 IP 기반 로그인
			#  실패 카운터(auth.py _client_ip)가 무력화된다.)
			header_up X-Forwarded-For {remote_host}
		}
	}

	handle {
		reverse_proxy frontend:3000
	}
}

# 평문 HTTP (로컬 확인 / WireGuard 터널 내부용)
:80 {
	import routes
}

# HTTPS — Caddy 내부 CA 자체 서명 인증서(WireGuard IP 대상)
https://{$WG_HOST}:443 {
	tls internal
	import routes
}
